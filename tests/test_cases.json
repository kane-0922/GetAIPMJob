          "expected_intent": "mock_interview_answer",
          "expected_tool": null,
          "eval_criteria": {
            "intent_correct": true,
            "response_contains": ["回答", "点评", "补充", "追问", "问题"],
            "has_feedback": true,
            "has_follow_up": true
          }
        },
        {
          "id": "MI-006",
          "name": "面试中用户不回答",
          "input": "这个问题我不太会，能换一个吗？",
          "expected_intent": "mock_interview",
          "expected_tool": null,
          "eval_criteria": {
            "intent_correct": true,
            "response_contains": ["没关系", "换", "问题", "鼓励"],
            "has_encouragement": true
          }
        }
      ]
    },
    "user_profile": {
      "description": "用户画像持久化模块测试",
