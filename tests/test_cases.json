          "eval_criteria": {
            "intent_correct": true,
            "tool_called": true,
            "response_contains": ["更新", "Agent", "技能"],
            "profile_updated": true
          }
        },
        {
          "id": "UP-004",
          "name": "画像驱动个性化推荐",
          "input": "根据我的情况，帮我推荐接下来应该学什么",
